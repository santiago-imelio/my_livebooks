```elixir
plt_data = [
  x: Nx.to_list(Nx.squeeze(x)),
  y: Nx.to_list(Nx.squeeze(y))
]

scatter = Tucan.scatter(plt_data, "x", "y", 
              width: 500, height: 500, point_color: "red", point_size: 50)
```

```elixir
bad_model = LinearRegression.fit(x, y)
```

```elixir
LinearRegression.predict(bad_model, Nx.tensor([[13], [21]]))
```

```elixir
x0 = 0.0
x1 = 13
y0 = Nx.to_number(bad_model.intercept)
y1 = Nx.to_number(LinearRegression.predict(bad_model, Nx.tensor([x1])))

bad_model_plt_data = [
  x: [x0, x1],
  y: [y0, y1]
]

Tucan.layers([
  scatter,
  Tucan.lineplot(bad_model_plt_data, "x", "y"),
])
```

```elixir
plot_ransac = fn ransac ->
  x0 = 0.0
  x1 = 13
  y0 = Nx.to_number(ransac.estimator.intercept)
  y1 = Nx.to_number(RANSAC.predict(ransac, Nx.tensor([x1])))
  
  ransac_plt_data = [
    x: [x0, x1],
    y: [y0, y1]
  ]
  
  Tucan.layers([
    scatter,
    Tucan.lineplot(ransac_plt_data, "x", "y"),
  ])  
end
```

```elixir
ransac1 = RANSAC.fit(
  x, 
  y,
  max_iters: 100, 
  min_samples: 2,
  random_seed: 42,
  threshold: 20000
)
plot_ransac.(ransac1)
```

```elixir
ransac2 = RANSAC.fit(
  x, 
  y,
  max_iters: 500, 
  min_samples: 2,
  random_seed: 42,
  threshold: 10000
)
plot_ransac.(ransac2)
```

```elixir
ransac3 = RANSAC.fit(
