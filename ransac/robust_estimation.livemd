## Section

```elixir
Nx.global_default_backend(EXLA.Backend)
Nx.Defn.global_default_options(compiler: EXLA)
```

```elixir
alias Scholar.Linear.LinearRegression
alias Scholar.Metrics.Regression, as: Metrics
```

```elixir
defmodule RANSAC do
  import Nx.Defn

  defstruct [
    :estimator,
    :inliers_indices,
    :n_inliers
  ]

  def fit(x, y, opts) do
    inliers_mask = fit_n(x, y, opts)
    n_inliers = Nx.to_number(Nx.sum(inliers_mask))
    
    if n_inliers == 0 do
      raise "RANSAC was not able to find consensus set that meets the required criteria."
    end

    inliers_idx = Nx.argsort(inliers_mask, direction: :desc)[0..(n_inliers - 1)]

    x_inliers = Nx.take(x, inliers_idx)
    y_inliers = Nx.take(y, inliers_idx)

    estimator = LinearRegression.fit(x_inliers, y_inliers)

    %__MODULE__{estimator: estimator, inliers_indices: inliers_idx, 
                n_inliers: n_inliers}
  end

  def predict(%__MODULE__{estimator: model}, x) do
    LinearRegression.predict(model, x)
  end
  
  defn fit_n(x, y, opts) do
    max_iters = opts[:max_iters]
    min_samples = opts[:min_samples]
    min_samples_t = Nx.broadcast(0, {min_samples})
    threshold = opts[:threshold]
    rand_key = Nx.Random.key(opts[:random_seed])
    data = Nx.concatenate([x, y], axis: 1)
    inliers = Nx.broadcast(0, {max_iters, elem(x.shape, 0)})

    {inliers_masks, _} =
      while {inliers, {i = 0, x, y, rand_key, data, min_samples_t, threshold}}, i < max_iters do
        # sample random points
        n_samples = elem(min_samples_t.shape, 0)

        {rand_samples, rand_key} = Nx.Random.choice(rand_key, data, 
                                                    axis: 0, samples: n_samples)
        
        {rand_x, rand_y} = Nx.split(rand_samples, elem(x.shape, 1), axis: 1)
        
        # evaluate samples using the given estimator
        model = LinearRegression.fit(rand_x, rand_y)
        y_pred = LinearRegression.predict(model, x)
        error = Nx.abs(Nx.reshape(y, y_pred.shape) - y_pred)
  
        # filter inliers and update context
        inliers_i = Nx.less(error, threshold)
        updated_inliers = Nx.put_slice(inliers, [i, 0], 
                                       Nx.reshape(inliers_i, {1, elem(x.shape, 0)}))

        {updated_inliers,
          {i + 1, x, y, rand_key, data, min_samples_t, threshold}}
      end

    # return best inliers mask
    best_mask_idx =
      inliers_masks
      |> Nx.vectorize(:masks)
      |> Nx.sum()
      |> Nx.devectorize(keep_names: false)
      |> Nx.argmax()

    inliers_masks[best_mask_idx]
  end
end
```

